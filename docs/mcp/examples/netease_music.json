{
  "mcpServers": {
    "netease_music": {
      "command": "python",
      "args": ["-m", "netease_music_mcp"],
      "cwd": ".",
      "env": {
        "NETEASE_COOKIE": "${NETEASE_COOKIE}"
      },
      "lifecycle": "lazy_keep_alive",
      "includeTools": [],
      "excludeTools": [],
      "yuki": {
        "scope": "mcp.netease_music",
        "summary": "歌曲、歌手、专辑、歌单和歌词",
        "tags": ["音乐", "网易云", "歌曲", "歌单"]
      }
    }
  }
}
